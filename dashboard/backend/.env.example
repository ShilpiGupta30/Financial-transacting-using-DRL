# MySQL settings (DB_USER and DB_PASSWORD are required for transaction reads)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_password
DB_NAME=resource_management_db

# Backend settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CPP_ENGINE_PATH=../../core_engine/build/IntelligentResourceManager.exe
SIMULATION_TIMEOUT_SECONDS=30
